# Server
PORT=3000
SKIP_AUTH=false   # set to true locally to bypass JWT checks during dev

# Google Sign-In — the "Web application" OAuth 2.0 Client ID from Google
# Cloud Console. Checked as the `aud` claim on every verified ID token;
# must match the frontend's --dart-define=GOOGLE_CLIENT_ID. Google's JWKS
# endpoint itself is fixed/public, so there's no URL to configure for that.
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Database (Supabase Postgres) — watchlist/bets/performance return 503 without it
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase project URL + service-role key — needed for onboarding avatar uploads
# to the `profile_pictures` Storage bucket. The service-role key bypasses Storage
# RLS (Settings > API > service_role in the Supabase dashboard); server-only,
# never expose it to the frontend. Uploads are skipped (503) without these.
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis — optional; the server falls back to an in-process cache when unset or
# unreachable. Auth goes inside the URL: redis://:password@host:6379
REDIS_URL=redis://localhost:6379
# REDIS_API_KEY is not read by the backend — kept here only as a reminder if a
# managed Redis provider hands you a key; put it in the URL instead.
# REDIS_API_KEY=abcdef1234567890

# Anthropic — required for AI scoring; markets are served unscored without it
ANTHROPIC_API_KEY=sk-ant-...

# Scorer web search — set to true to let Claude check recent news during the
# automated background scoring (billed per search by Anthropic; can add up at
# 30 markets per refresh). Off by default: the product direction is
# user-triggered research on the pro plan, not automated search.
SCORER_WEB_SEARCH=false

# Mixpanel — backend telemetry (market_scored events with token/search usage).
# Project token, same one the frontend uses; leave empty to disable.
MIXPANEL_TOKEN=73950bce8310f42d2fbcebeb8569b32c

# Kalshi — only needed for order execution (not part of MVP); market reads are public
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=
