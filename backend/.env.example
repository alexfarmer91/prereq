# Server
PORT=3000
SKIP_AUTH=false   # set to true locally to bypass JWT checks during dev

# Clerk — get JWKS URL from your Clerk dashboard
# Format: https://<your-clerk-domain>/.well-known/jwks.json
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_...

# Database (Supabase Postgres) — needed for step 7+
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis — needed for step 5+ (caching scored markets)
REDIS_URL=redis://localhost:6379

# Anthropic — needed for step 5+ (AI scoring)
ANTHROPIC_API_KEY=sk-ant-...

# Kalshi — only needed for order execution (step 7+); market reads are public
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=
